# Runtime
NODE_ENV=development
PORT=8000

# Postgres (Koyeb Managed Postgres connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reel_scheduler
# Set true on Koyeb (managed Postgres requires SSL), false for local Postgres
DATABASE_SSL=false

# Public URL of the deployed app (used later for OAuth redirects)
APP_BASE_URL=http://localhost:8000
